# OS and Editor junk
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Allow lab/env directory for Terraform variable templates
!lab/env/

# Terraform runtime
.terraform/
*.tfstate
*.tfstate.*

# Execution logs under logs/ are intentionally TRACKED (committed) for review/audit —
# pod stdout, NCCL traces, benchmark results, and run orchestration logs are kept in-repo
# so past runs are reviewable. (Previously these were ignored.)
!logs/.gitkeep
.superpowers/

# gcluster render / blueprint compose output
lab/build/

# Access rosters for the GPU-node grant scripts. THIS REPOSITORY IS PUBLIC, and these
# files list named employees against the machines they can log into or reboot. The
# *.example templates are tracked so the mechanism stays discoverable; the real rosters
# are not. Recover a lost roster from the live IAM policy, not from memory -- see the
# header of deploy/ops/vm-ops-team.txt.example.
deploy/ops/ssh-team.txt
deploy/ops/vm-ops-team.txt
